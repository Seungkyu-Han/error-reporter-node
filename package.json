{
  "name": "@seungkyu/error-reporter",
  "version": "0.0.3",
  "description": "Send server errors to chat application",
  "main": "dist/index.js",
  "types" : "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "slack",
    "error",
    "logging"
  ],
  "author": "Seungkyu-Han",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17"
  }
}
